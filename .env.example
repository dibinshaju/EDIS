# ==============================================================================
# Smart Water Monitor - Environment Configuration Example
# Copy this file to .env and configure credentials as needed.
# NOTE: The application launches in fully functional DEMO MODE if credentials are empty!
# ==============================================================================

# MQTT Broker Settings
# Public test broker (WebSockets for App, TCP 1883 for Wokwi ESP32)
EXPO_PUBLIC_MQTT_WS_BROKER_URL=wss://broker.emqx.io:8084/mqtt
EXPO_PUBLIC_MQTT_TOPIC_TELEMETRY=water/demo/telemetry
EXPO_PUBLIC_MQTT_TOPIC_COMMAND=water/demo/command

# Production Firebase Credentials (Optional - for Real SMS OTP & Push Notifications)
# If left blank, the app runs in Expo Go Demo Mode with zero configuration needed.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
